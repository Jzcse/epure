{
  "name": "vgd2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "node tools/serve.mjs",
    "start": "pnpm build && node tools/serve.mjs",
    "certs": "office-addin-dev-certs install",
    "register": "node tools/register.mjs",
    "unregister": "node tools/register.mjs --remove",
    "release": "tsc --noEmit && node tools/build-release.mjs"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.617",
    "office-addin-dev-certs": "^3.0.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
